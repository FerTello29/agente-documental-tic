OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_DRIVE_FOLDER_ID=
VECTOR_STORE_ID=
# Opcional: define una clave para permitir sincronizar por API local (X-Admin-Key).
LOCAL_ADMIN_KEY=
PORT=5000

# --- Solo para Vercel (Settings > Environment Variables) ---
# Contenido de data/manifest.json tras sincronizar en localhost (una sola línea JSON).
DOCUMENTS_MANIFEST=
# Opcional: código que el visitante debe escribir para consultar (cabecera X-Access-Key).
APP_ACCESS_KEY=
# Preguntas por minuto por IP y por instancia.
ASK_RATE_LIMIT=12
