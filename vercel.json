{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,tests/**,data/**,assets/**,index.html,README.md}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/:file(.*\\.py)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.py",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/requirements.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.env.example",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.gitignore",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
